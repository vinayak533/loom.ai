# =============================================================================
# BACKEND SECRETS — never expose any of these to the frontend bundle.
# The browser talks only to this FastAPI service; this service talks to vendors.
# =============================================================================

# --- LLMs ---
OPENROUTER_API_KEY=
XAI_API_KEY=
# Groq. Powers the Llama 70B entry in the model list, and names sessions when
# it is present. Optional like the rest — but leaving it blank silently drops
# a model the UI otherwise offers, which is why it is listed here explicitly.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL_A=llama-3.3-70b-versatile
GROQ_MAX_TOKENS=8000
# OpenCode Go. Required for Auto (task-routed) mode — without it Auto falls
# back to the older section table. Never copy this into frontend/.env.local.
OPENCODE_API_KEY=

# --- Tools ---
E2B_API_KEY=
EXA_API_KEY=

# --- Learn: notebook retrieval embeddings ---
# No key required. Notebook chunks are embedded in-process by a hashed
# bag-of-words vectoriser emitting the 768 dimensions the
# notebook_chunks.embedding column declares.

# --- Auto router: which model each section falls back to ---
# Only consulted when OPENCODE_API_KEY is unset. With OpenCode configured Auto
# classifies each turn instead and these are not used.
AUTO_ROUTE_CHAT=grok-4-5
AUTO_ROUTE_LEARNING=nemotron-3
AUTO_ROUTE_CODE=llama-4-scout

# --- Agentic Loop (the ten specialist agents) ---
# Every key below is optional and powers exactly ONE tool on ONE agent. With
# the key unset that tool reports "not configured" in the UI and the agent
# carries on without it — nothing is faked and nothing crashes.
#
# Tavily — web search. Used by Agent 6 (SEO) and Agent 7 (Research).
# The variable is spelled TEVILY_API_KEY for backwards compatibility with this
# project's existing .env; TAVILY_API_KEY is accepted as an alias.
TEVILY_API_KEY=
# Jina Reader — URL to Markdown. Agent 7's scraper. Falls back to the Learn
# section's own extractor when unset, so Agent 7 degrades rather than breaking.
JINA_AI_READER_API_KEY=
# Stability AI — Agent 5's image generation. Without it Agent 5 shows
# "Image generation not configured" and its other tools still work.
STABILITY_API_KEY=
# Which provider `generate_image` dispatches to. Only `stability` is wired.
IMAGE_GEN_PROVIDER=stability
# `core` (3 credits/image), `sd3.5-large` (6.5), `ultra` (8). Cheapest first.
STABILITY_MODEL=core
# Resend — Agent 2's real email send. Every send is gated behind Agent 9's
# approval card; nothing is sent without an explicit click.
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev
# LangSmith tracing. The key alone does nothing — set LANGSMITH_TRACING=1 too.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=0
LANGSMITH_PROJECT=atlas-agentic-loop

# --- Supabase ---
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=
# Postgres URI for the same database, used only by `scripts/apply_schema.py`.
# Supabase dashboard -> Project Settings -> Database -> Connection string (URI).
# The REST API cannot run DDL, so schema changes need this or the SQL editor.
SUPABASE_DB_URL=

# =============================================================================
# Optional tuning (all have safe defaults — see app/config.py)
# =============================================================================

# Comma-separated CORS allowlist. In production set this to your Vercel domain
# ONLY, e.g. https://my-agent.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Agent loop
MAX_AGENT_ITERATIONS=50

# OpenRouter — two distinct model slugs selectable in the UI (OpenAI-compatible).
# `_b` is gone; `_c` keeps its letter so existing .env files keep working.
# Session titles are named by whichever cheap model is configured — see
# TITLE_MODELS in app/agent/llm.py.
OPENROUTER_MODEL_A=nvidia/nemotron-3-ultra-550b-a55b
OPENROUTER_MODEL_C=meta-llama/llama-4-scout
OPENROUTER_MAX_TOKENS=8000

# xAI (Grok) — direct API, NOT via OpenRouter. base_url defaults to api.x.ai/v1.
# PRIMARY provider: Grok 4.5 is the default model in every section.
XAI_BASE_URL=https://api.x.ai/v1
# Grok 4.5 — verified against xAI's published model page: 500k context,
# function calling, image input, structured outputs. Note the dot in the
# wire id; the app's registry key is `grok-4-5` with dashes.
XAI_MODEL_GROK_45=grok-4.5
XAI_MAX_TOKENS=16000

# OpenCode Go — OpenAI-compatible. Note the `/zen/go/v1` path: the Go plan and
# the Zen plan share a codebase but serve different catalogues, and a Go key
# will not authenticate against Zen's `/zen/v1`.
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL_FAST=deepseek-v4-flash
OPENCODE_MODEL_EDIT=minimax-m2.7
OPENCODE_MODEL_VISUAL=qwen3.7-plus
OPENCODE_MODEL_COMPLEX=mimo-v2.5
OPENCODE_MAX_TOKENS=8000

# Which model_id new sessions start with. Must be a key of MODEL_REGISTRY.
DEFAULT_MODEL_ID=grok-4-5

# Auto router thresholds. Only read by app/agent/task_classifier.py — retune
# these rather than editing the router's dispatch code.
AUTO_COMPLEX_CONTEXT_TOKENS=24000
AUTO_COMPLEX_ITERATION_COUNT=6
AUTO_COMPLEX_PLAN_STEPS=5
AUTO_LOOKBACK_MESSAGES=6

# Sandbox
SANDBOX_IDLE_TIMEOUT_SECONDS=900
BASH_TIMEOUT_SECONDS=30

# Rate limiting (per session)
RATE_LIMIT_MESSAGES_PER_MINUTE=20
RATE_LIMIT_UPLOADS_PER_MINUTE=10

# LangGraph checkpointer. Leave blank to use a local SQLite file (good for dev).
# For Render + Supabase, set to your Supabase Postgres connection string and
# install `langgraph-checkpoint-postgres`.
CHECKPOINT_DB_PATH=./data/checkpoints.sqlite
POSTGRES_CHECKPOINT_URL=

# Set to 1 to require a Supabase Auth JWT on the websocket / REST endpoints.
# Require a signed-in user on every REST call and websocket. Leave at 0 only
# for local work with no Supabase Auth set up; anything reachable by anyone
# else should run with this at 1. Ownership is enforced independently of
# this flag (see app/api/ownership.py) — the flag decides whether anonymous
# callers exist at all, not whether they can reach each other's data.
REQUIRE_AUTH=0

# --- Credits (app/credits.py) ---
# Every agent turn is metered. Set CREDITS_ENABLED=0 only for local debugging;
# with it off nothing is charged and the balance readout is hidden.
CREDITS_ENABLED=1
# What one credit is worth in USD. The router's per-call cost estimate is
# divided by this to produce the debit, so lowering it makes credits finer.
CREDIT_USD=0.001
# Balance a user starts with the first time they run an agent.
CREDIT_STARTING_BALANCE=1000
# A turn will not start below this, so a run cannot open on a balance its
# first model call is certain to overdraw.
CREDIT_MINIMUM_TO_START=1
# The most a SINGLE turn may spend before it is cut off. The check above only
# guards the start of a turn, which is how a balance of 19.64 once ended one
# turn at -28.27. On crossing this the turn keeps its findings: tools are
# withdrawn and the model gets one final call to write up and say it stopped
# early. Set to 0 to disable the ceiling.
CREDIT_TURN_CEILING=150

# How the meter behaves when the durable store is unreachable: it falls back to
# an in-process ledger, retries on this interval (doubling to the max), and
# flushes what it buffered once the store answers.
CREDIT_STORE_RETRY_SECONDS=30
CREDIT_STORE_RETRY_MAX_SECONDS=300
# Where degraded-window movements are written so a restart cannot lose them.
# This file existing means there is unreconciled usage.
CREDIT_SPILL_PATH=./data/credit_spill.jsonl
