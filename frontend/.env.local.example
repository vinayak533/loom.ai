# These are the ONLY variables the browser is allowed to see.
# xAI / OpenRouter / E2B / Exa keys live in backend/.env and must never
# appear here — NEXT_PUBLIC_* values are inlined into the client bundle.

NEXT_PUBLIC_BACKEND_WS_URL=ws://localhost:8000
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
